   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0100",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "心ときめきしていひたりしかひなければかへしもせでとり返してはじめの人のがりやるとて我がとないひそと云ひければ",
   "author": "",
   "text": "在所細かに孰らしら瓜のつる14%を尋て我ならさなむ",
