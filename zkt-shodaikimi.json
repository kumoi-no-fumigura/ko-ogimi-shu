   "id": "zkt-shodaikimi-0094",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "とあれば",
   "author": "",
   "text": "誓ても有と賴めばたまさかに神の外なる程にも有けむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
