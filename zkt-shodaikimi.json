   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0119",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "又かへし",
   "author": "",
   "text": "穂に出て唯にも非じ花薄風のよするを厭はざらなむ",
