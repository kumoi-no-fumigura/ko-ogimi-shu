   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "田舍へやる文のあけどころに",
   "author": "",
   "text": "「天川浮木にのれる我ならば君があたりに今はきなまし",
   "sachu": "",
