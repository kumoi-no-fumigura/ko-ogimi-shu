   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "久しうなりて來りいり道にちりありと女いへば",
   "author": "",
   "text": "〓。なならぬ人も起臥す所には座のみゐると云ぞ怪しき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0130",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "10度ならで又ゐる人もなき物をとに無名も立ぞ侘しき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0131",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "十月におまへの菊いみじう移ろひたるを見て",
   "author": "",
   "text": "加誰かかく錦はかけし神無月機おる蟲の聲も絶えにき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0132",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "子の日をとこ女の許にいひたりける歌は覺えず女かへし",
   "author": "",
   "text": "bo野べ乍ら契りし〓とを待ならばつらき心も猶や賴まむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0133",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "ふたりながら聞きたりける程におろかになり給",
   "author": "",
   "text": "x初初ををししやや聞し時鳥きくにたがはぬ心ち社すれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0134",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "春宮にてなすびのゆゝしげなるにはがたのつきたるを見て",
   "author": "",
   "text": "ねくひ所みればうねなる老茄植たる人のくへるなるべし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0135",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "ためよりがいひける",
   "author": "",
   "text": "。人知れぬ心の儘に拾けるかひなからむと思けむやは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0136",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一君はかく忘れ只こそ拾ひけれうらなき物は我が心哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0137",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一霜〓る二見の浦のをしの上を君より外に誰か拂はむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0138",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "せえう殿の人々櫻のうたのもとにすゑつけたるとぞありける殿上の人々のつけゝるをし鳥をこに入れておごせたるに",
   "author": "",
   "text": "一人寄れど今は立げもなき鳥のこに籠れるや何の疑ひ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0139",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "翟麥を人のがりやるとて五月五日くすだまにつ",
   "author": "",
   "text": "〓〓麥の今日引植うる萬蒲草澤の物とは思はざらなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0140",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "雪の深きかをたさふやとばかり云て歸りたるに",
   "author": "",
   "text": "〓行指に跡尋ぬれば消にけるいつから越の方にか有けむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0141",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "內に參るに實方の中將月こそいとあかけれとのたまひしかば",
   "author": "",
   "text": "ル雲の上に誘はざりせば久方の身に添影も送らざらまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0142",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "葦たづの雲居の中にまじりなばなど云ひて失せたる人あはれにおもほゆる頃長歌",
   "author": "",
   "text": "れ久かたの空にたなびくうき雲のうける我身は",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0143",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "つゆ草の露のいのちもたま消て思ふことのみ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0144",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "もろこ菅繁さぞまさるあら玉の行く年つきの",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0145",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "春の日は花のにほひも夏の口も木の下かげも",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0146",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "秋の夜の月のひかりも冬の夜の時雨のおとも",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0147",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "世の中にこひも分れず憂きとはつらきも知ぬ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0148",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "我身こそ心にしみて袖の浦の干る時もなく",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0149",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "哀れなれかくのみ常に思ひつくいきの松ばら",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0150",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "生たるよながらの橋の長らへて瀨に居るたづの",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0151",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "鳴き渡りいづる浮世の水草みの我身にかけて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0152",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "°宵々の夢の魂足たかくありかで待たむ訪らひにこよ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0153",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一みるめ刈る狐の往來の湊ぢに勿來の關も我は据ぬに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0154",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "醍醐の御時に日でりのしければ雨乞の歌よむべ",
   "author": "",
   "text": "一千早振神もみまさば立騷ぎ天のと河の樋口あけたべ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0155",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "遣水に櫻の花の流るゝを見て",
   "author": "",
   "text": "ニ流の水木のもと近く流れずば泡沫花を有と見ましや",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0156",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "入撰集歌",
   "author": "",
   "text": "〓殊更に恨むともなし此頃の寢覺計りを知せてしがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  }
