 "blocks": [
  {
   "id": "zkt-shodaikimi-0001",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "知七花流す瀨をも見べき三日月のわれて入ぬる山の遠方",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0002",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "七うら枯るゝ淺芽が原の刈萱の亂れて物を思ふ頃かな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0003",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "その原や伏屋に生ふる帝木の有とは見えて逢ぬ君哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0004",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "枕のみ浮くと思ひし涙川今は我が身の沈むなりけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0005",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ル水底に沈める花の影見れば春は深くもなりにける哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0006",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "七Noねね待待し廿日の月の僅にも逢見し〓ともいつか忘む",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0007",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "忘れぬかぎりと思へどはか〓〓しうも覺えず人ごとをといふことのやうなり正月一日のことなるべし讀人知らず",
   "author": "",
   "text": "oいいにねて送る朝に云事ぞ昨日をミぞと今日を今年と",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0008",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "女御達のおほん局に候ひける時の御佛名の又の夜まゐりたるに人々集まりいでゝとくまゐれとせむれば何ごとならむと思ふにけづり花を庭にさしたりけるに雪のかゝりたるよめとなりけり心もえず",
   "author": "",
   "text": "一年年ままま誰誰ははをひ敢む菊の上とも暫し社みめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0009",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "昨日つかひし木賊のおちて露のかゝりたりけるをあしたに人の取り上げたりければ",
   "author": "",
   "text": "〓信濃野の木賊の上に置露の磨ける玉と見えにける哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0010",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "雨のふりけるよの宵に月の入るを見て詠める",
   "author": "",
   "text": "五大空に散にし花や匂ふらむ雲の春とも見ゆる宵かな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0011",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "竹のある所にて風の吹くにいみじうさゝめきければ",
   "author": "",
   "text": "風吹けば波やはさわぐ河竹の流るゝ水に聲の通へる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0012",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "十月に女院御はかうありて菊合せ騒ぎければ",
   "author": "",
   "text": "神無月ほとけの限願はるヽ庭のまもなく花ぞ降ける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0013",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "かいつのまに法に移ふ菊なれや過し物どもみえぬ今日哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0014",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "八覺束ななにしきつらむ紅葉見に霧の隱せる山の麓に",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0015",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "心若れば並木の花も賴まれず痛くな吹そ木枯の風",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0016",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "いと許多あれどかゝればとやめつ源宰相右兵衞督俄にをみに召されてそのあをずりを朝のまにせめられて病をかさぬるに氷のつきたれば",
   "author": "",
   "text": "限なくとくとはすれど足引の山井の水は猶ぞ凍れる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0017",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "といふかの御上のかくなむとあれば",
   "author": "",
   "text": "cm足曳の山井に凍る水と云ばとく共袖の程ぞ知らるゝ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0018",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "人の許にきける人の三年ばかり更に見えざりけるを見むとてあすは明けはてゝくるまはゐてこといひたりければあやしう久しき事と思へど人をやりてそひてこといはせたりけるをつととらへて內にもえ入らでみしていとねたかりければ男藤大納言とか",
   "author": "",
   "text": "〓岩橋のよるの契も絕えぬべしあくる怪しき為城の神",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0019",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返しをと",
   "author": "",
   "text": ";A秋立てば見しとや思ふ葛城の神の夜にて巳ぬべき或",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0020",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "此の同じ人なほし姿にてきて今宵は內のとのゐなりこれをきたれとて蒔繪の鞘に沈の束さしたるかたなをおきていぬるが三日ばかり音もせざりけるに刀とりてみけるに錆びたりければ、女",
   "author": "",
   "text": "ひとぎ置し鞘の刀も錆に見さして久しく程やへぬらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0021",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "とてやりたりければ",
   "author": "",
   "text": "かね弱み返る刀に身を做て束のまもなく戀や渡らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0022",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "をとこ心ちそこなひて四五日ばかり內へも参らでありけることといひてありける書に",
   "author": "",
   "text": "斯てもや消えむと思ふ自露の起居て結ぶ水莖をみよ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0023",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "熱露により幕るゝ影まつ草の葉に斯る折しも消のと云べき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0024",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "これを見て三日なむなきしといひけるこそそらご藥玉を女のがりやるとて男に代りて",
   "author": "",
   "text": "沼ごとに袖ぞ濡ぬる萬滿草心に似たるねを求むとて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0025",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返し、女",
   "author": "",
   "text": "〓苦しきに何求むらむ菖蒲草安積の沼に生ふと社きけ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0026",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "美濃の守よりみつめなくなしての頃霜のいみじきあしたに、人",
   "author": "",
   "text": "此頃のよはの穿覺は思遺るいかなる爲か霜拂ふらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0027",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "co冬の夜の霜打拂ひなくとは番はぬ爲の業にぞ有ける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0028",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "これなかの朝臣病に煩ひて三河のしほぢをよびに宮權大進むぬまさをやりていはせけるに更に聞き入れざりけるを强ひていひければすこし宜しきを賴にて曉にといひてねぬるに夜なかばかりに起き出でゝあらひがねうちて佛に物申す音しければさや〓〓と思ふに音もせずなりにけり弟子をおこしていづちかおはしぬるぞとてはもとむれどなくなりにけり沒ましうて書きおき逃げにけり",
   "author": "",
   "text": "。長き夜の道に感へる我おきて行隱れぬるよはの月哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0029",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "入道の返しあしたにぞありける",
   "author": "",
   "text": "c0重なれるみ山隱れにすむ人は月を〓へむ以だになし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0030",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "二條の右の大臣八月ばかりに參り給うて歌一つ詠ませて給はらむと上にせめ聞え給へばせむ方なくて草の葉の上にとありし御返りはこれなり",
   "author": "",
   "text": "po露深き草葉の上もいひ難み何につけてか秋を問らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0031",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓秋の夜の草葉の上の露の身を其に付ても語置かなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0032",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "局より御楔の日說に英をかけて上に進らせ給へるおろしを給はせたるに",
   "author": "",
   "text": "00場垣のあたりに馴ぬきね!りも神にいち著し今は翳さじ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0033",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返し忘れにけり又五月五日さうぶの根を爲につくりて梅の枝にすゑ給へる",
   "author": "",
   "text": "わ梅枝にとり違へたる郭公聲のあやめも誰か分くべき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0034",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "お名告せで梢にこずば郭公春かけてこし鳥とかや見む",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0035",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "ずみやう經よませむとかやぞありし宮にすりの藏人とてさぶらひし人の大ばん所にひとりありけるをそれとらへよとゆきよりに仰せられければとらへて更にゆるさでふしぬるを夜一夜いとほしと思ひふしておきていく程にいひける",
   "author": "",
   "text": "10長かれよ朝ねの髪の千代結ぶ契と見れば悲しかり兒",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0036",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返しゆきより",
   "author": "",
   "text": "ね。長かれと云ずば長く非じとや文なく君がめには見ゆ寛",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0037",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "上とのゐとておまへに近く候ふ人々あやしきくれの枕を落して出でたるにつけたるを人々彼の上にやりたり",
   "author": "",
   "text": "。道芝やおどろの髪に別らされて積れるか社草枕なれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0038",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "さぶらはざりし人々はいみじう笑ふにあるたいふ殿上にすみもてくる男を遲く參りたりとてその時に候ひし藏人今は上に參りしよりその人のとらへてかみに繩をゆひつけて許さゞりしかばものより除かせ給うてこはたかゝらせ給ふかともこり侍るべくとて許さヾりしかば女房方より",
   "author": "",
   "text": "一大原やすみのかしらの繩許せこのめに涙浮ぶと云也",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0039",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "りと仰せられしこそ人の許に罷りたりける男の見侍りけるを知らでほかげに小侍從といふ人のさし出でヽ人に物いひける、男",
   "author": "",
   "text": "一みつの江の額に問はヾや白波の夜光るてふ玉も斯やと",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0040",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "いかでいはむなどいひけるにねたりける寢言に",
   "author": "",
   "text": "一〓〓告告〓〓〓〓〓〓〓かしく袖に止らぬ玉も散けむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0041",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "たりければ",
   "author": "",
   "text": "〓春風に散りはてにけむ梅の花たゞか計ぞ枝に殘れる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0042",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "中將の命婦に馬の內侍の八月ばかりにいひやる見染めけることも秋とか",
   "author": "",
   "text": "枝繁み下にもえつる萩の花秋知りそむる人や戀しき一",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0043",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "〓色待で末にし消る雪ならば遂に錦は見てややまゝし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0044",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "えあはぬ人にいはむとて男のいふ",
   "author": "",
   "text": "一今日は我が消果てなまし中々に後を賴まむ命知ぬに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0045",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "殿上人桂より舟にて渡るに星の影のみえければをぐらの森のおぼつかなさに返したれそや",
   "author": "",
   "text": "如妬き我が小倉の里に宿りして紅葉の色をよそに聞哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0046",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "初雪のあしたに昔を思ひいでゝ",
   "author": "",
   "text": "〓珍らしと云べけれ共初雪の昔ふりにし今日ぞ悲しき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0047",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一ふりぬ共消せぬ物にあらませば袖は濡じな今口の初雪",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0048",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "みちのぶの君人の許におはしてあしたに",
   "author": "",
   "text": "ニ路よりも儚なかりける心哉けさ我何し起てきつらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0049",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "かゝる人々らおはせぬを思ふにいと悲しくてかきもやられず同じ人服ぬぎ給ひし",
   "author": "",
   "text": "限あれば今日脫捨てつ藤衣涙の果ぞ知られざりける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0050",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "又みちのぶの君實方の君に三月中のほど",
   "author": "",
   "text": "散發る花はありやと打群れてみ山隱れに尋てしがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0051",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "まだ散ぬ花もや有と尋見むあなかま暫し風に知すな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0052",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "ためなかみちの國のかみにてくだる四條の大きおほい殿のせんし給ふに",
   "author": "",
   "text": "知武の松を見つゝや慰めむ君が千年の影にならひて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0053",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "正平五年の程はいみじう人しぬその頃木工のくら人里より",
   "author": "",
   "text": "一起も敢ず傳き空の露を爭で貫きとめむ玉のをもがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0054",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "また門宮",
   "author": "",
   "text": "〓草の葉に非ぬよなれどともすれば露は我身の上かとぞみる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0055",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "乞がまだ消ぬに消る頃なれば露社人を露と見るらめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0056",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "これは皆人の扇にあなり此のかへり、宮の御",
   "author": "",
   "text": "〓今はさは止るべきよの玉ならず白き蓮の露を見らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0057",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一常よりも常なき頃の露のみをいかに云てか日をば暮さむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0058",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "かくいひし人のなくなりにしが",
   "author": "",
   "text": "「見る程も無て消ぬる露よりも誰か此世に遂に止らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0059",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "宮の御元結よりて参り給ふことはたいふどのなむ仕うまつり給ひしを北の方うせ給うて忌はてヽの程にめしたるに仕うまつりおくとなむみ侍りおきし今もとめて參らむと聞えおき給ひて三四日ありて物の中より侍りけるを見給ふるにも哀なること多くなど聞え給へるに",
   "author": "",
   "text": "モ千侘る袖の中にや有つらむ是をぞ玉の〓にはよらまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0060",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "御社ビ",
   "author": "",
   "text": "三王の〓を君が爲にとより置て衣の裏を見ずぞ成にし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0061",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "宮に宮の御いかの事爲たふの君仕うまつり給ふに松の實入りたるをそのかたに作りてありし時",
   "author": "",
   "text": "一時いきて長閑き物は天の下ちよまつ枝の蔭にざりける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0062",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "その返しを仰せごとにて",
   "author": "",
   "text": "極難にかはこゝらの年を數へこむ松の一葉を千世と置つゝ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0063",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "東三條の院に渡らせ給ひて池の浮草どものむつかしげなる拂はせ給ひていとをかしければ",
   "author": "",
   "text": "〓君住めば濁れる池も無りけり汀のたづも心してゐよ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0064",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "女の許に物をだにいはむとて來たりける人旦に",
   "author": "",
   "text": "〓消え返りあるかなきかの我身哉恨みて歸る道芝の露",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0065",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "衰とも草葉の露や問れまし道の空にて消なましかば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0066",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "おなじ人",
   "author": "",
   "text": "coひひぶぶるに死なば中々遮莫生きてかひなき物思身は",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0067",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "〓なくなればなげの哀も云るゝをさは心みにあくがれれ魂",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0068",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "一身の憂に這伏す葦の假にても賴む計の言の葉ぞなき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0069",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "男松をむすびて",
   "author": "",
   "text": "三染め返し幾しほへてか石上おふる松葉を結びおく哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0070",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "〓ののはは結びもしてむ高砂の松には及ぶ人や無らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0071",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "同じ人女のもとにきてかどをたゝきけるに明けざりければ歸りてあしたに恨みたりければ",
   "author": "",
   "text": "尋ねべき人も覺えぬ我門の夜は葎の根こそさすらめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0072",
   "pid": "873676",
   "pages": [
    14
   ],
   "no": null,
   "kotobagaki": "返しをとこ",
   "author": "",
   "text": "如草葉だに心有らし八重葎いる人わきて圓の戶させば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0073",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓此世にはつきしも果じ思ふ〓と命の後はいつか絶べき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0074",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "返しなるべし",
   "author": "",
   "text": "我死なば孰こをはかと尋れてか此世に盡ぬ〓とも語らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0075",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "同じ人常にいへば今などいふがことざまになりぬべしと聞きて",
   "author": "",
   "text": "AP我や明し浦島の子が玉櫛筒結びし袖の空に見えねば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0076",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓玉楠筒袖から雲の立しより空の長めを刈ぬ日ぞなき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0077",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "かし",
   "author": "",
   "text": "一空にこそつらき數かけ河鴨の百羽掻には過やしぬ覽",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0078",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "扇の縫ひ物したるを持たせ給ひてこれ見よと仰せられて給はせたるに郭公の卯の花くひていくかたありたゞにやはとて",
   "author": "",
   "text": "31垣ね出る便に移る卯花を惜むと聲は立てぬなるべし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0079",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "これを實方に給はせたれば",
   "author": "",
   "text": "三時鳥なくにし散らば卯花の垣ね乍らぞ聞べかりける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0080",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "住吉に故大將殿のまうで給ひけるに夕日の入る程に空いと心細うて松の下に浪の寄するを",
   "author": "",
   "text": "松松れば焦れぬ物を住の江のいかなる波か靜心なき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0081",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "三條の中納言殿にありし大夫君蜘蛛の巢に花をふきかけたるを見て",
   "author": "",
   "text": "小蟹の卿のをはたは薄けれど散來る花は洩さやり島",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0082",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "實方の中將人のがりやらむとでためたふの君にかくいはむはいかゞといひける歌",
   "author": "",
   "text": "〓等でかは思ありとは知すべき室の八島の煙ならでは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0083",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "をかしなどいひて爲たふの君わが懸想する人のがりやりてけり女も聞きてわらふ程にわたりければ女と云ひければかねもりが大井にてよめりし",
   "author": "",
   "text": "〓大井河そま山風の寒けくに岩打つ波を雪かとぞ見る",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0084",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "おなじ人大監物なりし時內侍所にみがきまうしに大含人のひきいでに來たるにある人內侍のすけの知るやうありてそこにありける折なりければまへにありけるたちふといふうりを黃なる色紙につゝみて大舍人なりける翁にとらせたりければ廠司につきてそこよりいふ",
   "author": "",
   "text": "山山ののはは通通てみてしがな瓜作ける人の垣ねを",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0085",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "の常とはにゆけば也見瓜作り其〓となきに立てりしや君",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0086",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "又の日つかさめしに駿河守になりて喜び申しに參りて袖より落しおきたりしはいとこそ",
   "author": "",
   "text": "一瓜つくる園生も知ず人しれず落る淚やそぼつなるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0087",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "いとからくとぞありし七夕のあしたに春宮にてひんがしにたちはきのをさのありしかたにひきたる糸にくもの巢をかきければゆきよりにしかけ〓〓となむおとりたてると仰せられしがば",
   "author": "",
   "text": "〓さゝ蟹のもろてに急ぐ七夕の雲の衣は風やとくらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0088",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "とありしを實方の君に語り給ふめりしかば立ち",
   "author": "",
   "text": "產星のくべき宵とや小蟹の雲のい掻も懸て見えけむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0089",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "藤大納言少將にておはせし程に女御の御方七夕祭したる所にきて物いはむとありしかばすの本にて何かといひておはしにけるをそれより給へりけりと人々聞き給へりけりとて朝によろづのちかごと文に書きて見せよとおぼしくてあり",
   "author": "",
   "text": "七夕にかしつと思ふ逢事を其夜なき名の立にける哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0090",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "あるやんごとなき人の許に忍びて十年ばかり通ふ程に今宵かくてといひたりけるをまらうど多くて遊びしなどしてえさらざりければ又の日そのことをいひて今宵は命だにあらばかならずと",
   "author": "",
   "text": "〓かかぬぬ命は我も讓りてむ賴むる〓とを誰に見せまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0091",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "同じ人そのよ物だにいひあへでとぞいひし",
   "author": "",
   "text": "終夜ひぢ明しつる衣手の今朝も變らぬ程を知らなむ",
