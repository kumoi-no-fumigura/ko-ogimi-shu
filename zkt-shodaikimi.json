   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0121",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "又この頃ものへ行くとて",
   "author": "",
   "text": "〓別行くかたしの道に置霜の消えむ半に袖や濡れなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0122",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "〓狩捨て行きなむ後の衣手は君一人しも濡じとぞ思ふ",
