   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "co空言と云べけれども神無月思出でつゝ且は知らるヽ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0128",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "30常よりも戀しくなりて神無月絕ずも袖の潤ふなる哉",
