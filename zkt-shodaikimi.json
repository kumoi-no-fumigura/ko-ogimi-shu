   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0123",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "又をと",
   "author": "",
   "text": "結ぶ手は〓とになる共花薄とくる迄だに忘れざらなむ",
