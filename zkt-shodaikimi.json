   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0102",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "五月五日",
   "author": "",
   "text": "諸共に逢見ぬ沼のねを引ば忘やしにし長からぬなか",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0103",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "雨降るとてこぬ人のふらぬにも見えねば",
   "author": "",
   "text": "〓ふらぬ夜の心を知で大空の雨をつらしと思ひける哉",
