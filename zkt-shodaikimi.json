   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0116",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "→大空の旅の空なる濡衣をたがもとゝてかかたへきつ覽",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0117",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "九月ばかりに同じ男に",
   "author": "",
   "text": "花薄穗に出に見わが爭で人に知られて結ぶわざせむ",
