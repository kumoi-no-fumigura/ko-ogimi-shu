   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0126",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "。霜枯の侘しき〓とは思へ共おきては露の草葉ならぬに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
