   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0104",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "同じ人いみじうわづらひて今日は死ぬべしなたのみそとのたまへりしかば",
   "author": "",
   "text": "〓君により暮まつ草に置露のかゝらむ程を如何賴まぬ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0105",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "文おこする人返りごとをせぬいみじう恨みてこたみばかりと云ひければこと手にて",
   "author": "",
   "text": "c踏踏な見そ渡しもはてぬ岩橋ぞ中々道の空にわびなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0106",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "常陸守なりよりかゝれ侍りし頃",
   "author": "",
   "text": "「あだ人の假に訪くる我宿に今は葎のねこそはふらめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0107",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "同じ人のきたりけるに〓と人のありしかばけはひをえていみじう恨み侍りしかば夙めてこれより",
   "author": "",
   "text": "恨恨む覽心はまだや解けざらむ置つる霜のけさの寒さに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0108",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "また人に",
   "author": "",
   "text": "殊更に恨むともなし此頃の寢覺計りは知せてしがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0109",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "宮にて弓いさせ給ふにくらうなるに人召すにおそければ",
   "author": "",
   "text": "待つ程に久しかりけり行末のまだ遠ければ武隈の松",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0110",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "實方の君親に後れて歎くと聞く頃",
   "author": "",
   "text": "底はふち淵は瀨ならぬ涙川袖の渡りは有じとぞ思ふ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0111",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "瓜の靑きなるををしのかへりみむきたる由をこれはいかゞいふべきと葦手に書きて進らせたりつれば宮より",
   "author": "",
   "text": "か瓜生野の澤に住ぬるをし鳥の雲居に通ふ心あるらし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0112",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "心心をし雲居としめば葦たづの齡とのみは思ざらまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0113",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "菩むさば拾ひも替む細れ石の數に皆とるらよは幾つぞ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0114",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "七月七日大入道殿の御いみなる程にすゝきにひ",
   "author": "",
   "text": "か世中に包まり年の秋ならばをかしからまし今日の七日も",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0115",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "文などおこせける人のものにいきて程もなく歸りきたれば",
   "author": "",
   "text": "唯今ぞきつると思ふ袖の上の裏上もなく成にける哉",
