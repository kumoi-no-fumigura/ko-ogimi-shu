   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-shodaikimi-0099",
   "pid": "873676",
   "pages": [
    15
   ],
   "no": null,
   "kotobagaki": "ちひさき瓜の黃なるを同じ色の紙につゝみてあさみつの少將のがりやるをきゝたがへてよりひらにとらせたれば",
   "author": "",
